/////////////////////////////////////////////////////////////////////////////
//
// 图标
//

// ID 值最低的图标放在最前面，以确保应用程序图标
// 在所有系统中保持一致。
IDR_MAINFRAME           ICON         "res\\miaomiaomiao.ico"


#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_CHS)
LANGUAGE 4, 2

/////////////////////////////////////////////////////////////////////////////
//
// 对话框
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 miaomiaomiao"
FONT 9, "MS Shell Dlg"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "miaomiaomiao，版本 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "版权所有 (C) 2025",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "确定",IDOK,113,41,50,14,WS_GROUP
END

IDD_MIAOMIAOMIAO_DIALOG DIALOGEX  0, 0, 320, 220
STYLE DS_SHELLFONT | WS_POPUP | WS_VISIBLE | WS_CAPTION
 | WS_THICKFRAME
 | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "计算三角形的面积"
FONT 9, "MS Shell Dlg"
BEGIN
    // 静态文本提示
    CTEXT           "请输入三角形三条边的长度：",IDC_STATIC_PROMPT,10,20,300,15
    
    // 第一条边
    CTEXT           "边长1：",IDC_STATIC,10,50,40,15
    EDITTEXT        IDC_EDIT_SIDE1,55,48,50,20,ES_NUMBER
    
    // 第二条边
    CTEXT           "边长2：",IDC_STATIC,115,50,40,15
    EDITTEXT        IDC_EDIT_SIDE2,160,48,50,20,ES_NUMBER
    
    // 第三条边
    CTEXT           "边长3：",IDC_STATIC,220,50,40,15
    EDITTEXT        IDC_EDIT_SIDE3,265,48,50,20,ES_NUMBER
    
    // 结果显示
    CTEXT           "三角形的面积为：",IDC_STATIC_RESULT,10,100,100,15
    EDITTEXT        IDC_EDIT_AREA,120,98,150,20,ES_READONLY | ES_AUTOHSCROLL
    
    // 按钮
    PUSHBUTTON      "计算面积",IDC_BTN_CALC,80,150,80,25
    PUSHBUTTON      "退出",IDC_BTN_EXIT,160,150,80,25
END

/////////////////////////////////////////////////////////////////////////////
//
// 版本
//

VS_VERSION_INFO     VERSIONINFO
  FILEVERSION       1,0,0,1
  PRODUCTVERSION    1,0,0,1
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "TODO: <公司名>"
            VALUE "FileDescription", "miaomiaomiao"
            VALUE "FileVersion",     "1.0.0.1"
            VALUE "InternalName",    "miaomiaomiao.exe"
            VALUE "LegalCopyright", "TODO:  (C) <公司名>。  保留所有权利。"
            VALUE "OriginalFilename","miaomiaomiao.exe"
            VALUE "ProductName", "TODO: <产品名>"
            VALUE "ProductVersion",  "1.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END

